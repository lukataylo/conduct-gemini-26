# Copy to env.local (this repo) or .env (what the READMEs assume):
#   cp env.example env.local
# Never commit env.local / .env — both are gitignored.
#
# Track 2 (you) needs: GEMINI_API_KEY, Modal, optional LOGFIRE_TOKEN.
# Everything below that is for other tracks or later tonight.

# -----------------------------------------------------------------------------
# Gemini — required for parse + computer use
# Get a key: https://aistudio.google.com/apikey
# Use AI Studio, not Vertex. Tier 1 is enough to start; swap a tier-2 key if
# you hit rate limits.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# Alias accepted by agent-runtime if you already filled this instead:
# GEMINIAPIKEY=

# -----------------------------------------------------------------------------
# Pydantic Logfire — traces every Pydantic AI / parse / computer-use call
# Sign up: https://logfire.pydantic.dev/
# Create a project → write token. Optional until instrumentation is wired;
# core demo still works without it, but the audit "click through to the span"
# story needs it.
# -----------------------------------------------------------------------------
LOGFIRE_TOKEN=

# -----------------------------------------------------------------------------
# Modal — hosts parse + computer-use sandbox + noVNC watch URL
#   pip install modal && modal token new
# That writes ~/.modal/ or prints MODAL_TOKEN_ID / MODAL_TOKEN_SECRET.
# Then:
#   modal secret create access-scope-agent-secrets \
#     GEMINI_API_KEY=... LOGFIRE_TOKEN=...
# -----------------------------------------------------------------------------
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Printed by `modal serve agent-runtime/modal_app.py` / `modal deploy`.
# backend-api (track 5) calls these. Leave blank for policy-only local runs.
AGENT_RUNTIME_PARSE_URL=
AGENT_RUNTIME_EXECUTE_URL=

# computer_use (default) or playwright (typed clicks, no vision — stage fallback)
EXECUTE_GRANT_MODE=computer_use
# Override CU model (official preview also lists gemini-3.6-flash / gemini-3.5-flash-lite)
# GEMINI_CU_MODEL=gemini-3.8-flash
# Thinking: low is fastest on 3.8 Flash (minimal is invalid on 3.8)
# GEMINI_CU_THINKING=low

# Mock console the sandbox drives. WS2 stub until track 4 ships theirs.
# Must be reachable from a Modal container (not localhost). Use a tunnel or
# the Railway/public URL track 5 deploys.
CONSOLE_URL=

# backend-api origin as seen from Modal (callbacks to POST /audit).
# localhost does not work from a Modal sandbox.
BACKEND_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Anthropic — NOT required. Computer use is Gemini, not Claude.
# Only fill this if someone later wants the Anthropic loop as a spare.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# TypeSafe Jev — deferred (waitlisted). Do not block on this.
# https://typesafe.ai/
# -----------------------------------------------------------------------------
# TYPESAFE_API_KEY=

# -----------------------------------------------------------------------------
# backend-api (track 5)
# -----------------------------------------------------------------------------
BACKEND_API_PORT=8000
DATABASE_URL=sqlite:///./local.db

# -----------------------------------------------------------------------------
# Railway — optional, track 5 deploy of backend-api / generative-ui
# -----------------------------------------------------------------------------
RAILWAY_TOKEN=

# -----------------------------------------------------------------------------
# Real GCP — owner: eddbr. Mock is used unless REAL_GCP=true.
# See CLAUDE.md. Track 2 must keep working with REAL_GCP=false.
# No service-account key files. Impersonation only.
# -----------------------------------------------------------------------------
REAL_GCP=false
GCP_PROJECT_ID=
GCS_BUCKET_ANALYTICS_RAW=
BQ_DATASET_PROJECT_X_FINANCE=project_x_finance
ALEX_SA_EMAIL=
GRANTER_SA_EMAIL=
