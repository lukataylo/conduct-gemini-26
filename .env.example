# LLMs
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Modal (agent-runtime deployment)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Railway (backend-api / generative-ui deployment) — optional, only needed for deploy
RAILWAY_TOKEN=

# backend-api
BACKEND_API_PORT=8000
DATABASE_URL=sqlite:///./local.db

# Real GCP (optional) — mock is used unless REAL_GCP=true. See CLAUDE.md.
REAL_GCP=false
GCP_PROJECT_ID=
GCS_BUCKET_ANALYTICS_RAW=
BQ_DATASET_PROJECT_X_FINANCE=project_x_finance
ALEX_SA_EMAIL=

# Write guard for the hub. Unset = open (local dev). On the demo laptop set both to the same
# secret: the console sends it as X-Demo-Key on every write, the MCP server via APERTURE_TOKEN.
DEMO_KEY=
# generative-ui/.env.local (gitignored):  VITE_DEMO_KEY=<same value>
